DB_HOST=localhost
DB_PORT=5432
DB_USER=musicapp
DB_PASSWORD=musicapp
DB_NAME=musicapp
JWT_SECRET=
JWT_EXPIRES_IN=7d
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM=

# Payments (MVP-025). Unset = no provider; funding-payment routes fail closed.
# PAYMENT_PROVIDER=mock (local only) or cashfree. The mock secret needs >= 16 characters.
PAYMENT_PROVIDER=
MOCK_PAYMENT_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=

# Asset storage (MVP-010). ASSET_STORAGE_PROVIDER unset = local (OS temp dir unless
# ASSET_LOCAL_STORAGE_ROOT is set). Upload sessions fail closed until the TTL is a positive integer.
ASSET_STORAGE_PROVIDER=
ASSET_LOCAL_STORAGE_ROOT=
ASSET_UPLOAD_SESSION_TTL_SECONDS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
