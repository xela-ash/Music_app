{
  "name": "MusicApp 1738",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": "chmod +x .cursor/install.sh .cursor/start.sh && ./.cursor/install.sh",
  "start": "./.cursor/start.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && npm run dev"
    },
    {
      "name": "frontend",
      "command": "cd frontend && pnpm dev"
    }
  ],
  "ports": [
    {
      "name": "frontend",
      "port": 5173
    },
    {
      "name": "backend",
      "port": 4000
    }
  ]
}
